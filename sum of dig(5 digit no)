#include <stdio.h>

int main() {
    int num, sum = 0;

    printf("Enter a 5-digit number: ");
    scanf("%d", &num);

    // Check if the number is 5-digit
    if (num < 10000 || num > 99999) {
        printf("Invalid input! Please enter a 5-digit number.\n");
        return 1;
    }

    // Extract and sum each digit
    while (num > 0) {
        sum += num % 10;  // Get the last digit and add to sum
        num = num / 10;   // Remove the last digit
    }

    printf("Sum of digits = %d\n", sum);

    return 0;
}
