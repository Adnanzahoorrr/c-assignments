#include <stdio.h>

int main() {
    int amount, hundreds, fifties, tens;

    // Input the amount
    printf("Enter the amount to withdraw (in rupees): ");
    scanf("%d", &amount);

    // Check if amount is a multiple of 10
    if (amount % 10 != 0) {
        printf("Amount must be in multiples of 10.\n");
        return 1;
    }

    // Calculate the number of notes
    hundreds = amount / 100;
    amount = amount % 100;

    fifties = amount / 50;
    amount = amount % 50;

    tens = amount / 10;

    // Output the result
    printf("100 rupee notes: %d\n", hundreds);
    printf("50 rupee notes: %d\n", fifties);
    printf("10 rupee notes: %d\n", tens);

    return 0;
}
